rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'QHS8fA0mGEYV4aayfJ0DFVVRshT2',
        'QHS0fA0mGEYV4aayfJ0DFVVRshT2'
      ];
    }

    // Testimonials
    match /testimonials/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // Products
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{docId} {
      allow read: if isAdmin();
      allow create: if true
        && request.resource.data.customerName is string
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice > 0;
      allow update: if isAdmin()
        || (request.auth == null
          && resource.data.status == 'waiting_payment'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProof', 'status', 'updatedAt']));
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stats
    match /stats/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
