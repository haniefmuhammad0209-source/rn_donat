rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'QHS8fA0mGEYV4aayfJ0DFVVRshT2',
        'QHS0fA0mGEYV4aayfJ0DFVVRshT2'
      ];
    }

    // Testimonials — read public, create hanya user login, delete admin
    match /testimonials/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // Products — read public, write admin only
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — create public (siapapun bisa order), read/update admin
    match /orders/{docId} {
      allow read: if isAdmin();
      allow create: if true
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice > 0;
      allow update: if isAdmin();
    }

    // Settings — read public (store status, QRIS URL), write admin
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stats — read public, write admin only (counter diupdate saat order paid)
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stock — PENTING: Collection untuk stock donat polos
    match /stock/{docId} {
      allow read: if true;
      // Admin bisa semua operasi write (create, setStock, setThreshold)
      allow write: if isAdmin();
      // Allow update untuk unauthenticated (untuk reduceStock saat customer order)
      allow update: if true;
    }
  }
}
